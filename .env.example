# ============================================
# SDR AGENT - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e configure conforme instruções
# 
# LEGENDA:
#   [OBRIGATÓRIO] - Precisa buscar no painel do serviço
#   [OPCIONAL] - Pode deixar vazio se não usar
#   [AUTO] - Pode ser gerado automaticamente pelo script
# ============================================

# ============================================
# OPENAI / LLM (PROVEDOR PRINCIPAL)
# ============================================
# [OBRIGATÓRIO] Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo para o agente (padrão: gpt-5.4-mini)
OPENAI_MODEL=gpt-5.4-mini

# Temperatura para geração (0.0 a 1.0, padrão: 0.7)
OPENAI_TEMPERATURE=0.7

# ============================================
# SUPABASE (BANCO DE DADOS)
# ============================================
# [OBRIGATÓRIO] Obter em: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# CAL.COM (AGENDAMENTO)
# ============================================
# [OPCIONAL] Obter em: https://app.cal.com/settings/developer
# Deixe vazio se não for usar agendamento nesta fase
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v1
CALCOM_EVENT_TYPE_ID=

# ============================================
# LANGFUSE (OBSERVABILIDADE) - OPCIONAL
# ============================================
# [OPCIONAL] Obter em: https://cloud.langfuse.com
# Deixe VAZIO se não for usar tracing nesta fase
# O sistema funciona normalmente sem Langfuse (fail-safe)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# CHATWOOT (OMNICHANNEL) - OPCIONAL
# ============================================
# [OPCIONAL] Permite receber mensagens de WhatsApp/Instagram/Web via Chatwoot
# Obter em: Chatwoot → Settings → Account Settings (ID na URL)
# Token: Settings → Applications → API Access Tokens

# URL base da instância (self-hosted ou cloud)
CHATWOOT_BASE_URL=https://app.chatwoot.com

# API Access Token (bot ou super admin)
CHATWOOT_API_TOKEN=

# Account ID do Chatwoot (número na URL: /app/accounts/XXXX)
CHATWOOT_ACCOUNT_ID=0

# Inbox ID do canal (WhatsApp, Instagram, etc.)
CHATWOOT_INBOX_ID=0

# Secret para verificar assinatura HMAC dos webhooks
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHATWOOT_WEBHOOK_SECRET=

# ============================================
# SEGURANÇA INTERNA (GERAR AUTOMATICAMENTE)
# ============================================
# [AUTO] Executar: python infra/scripts/generate_secrets.py
# Ou usar o comando: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Secret key para sessões e tokens internos
APP_SECRET_KEY=

# Secret para sessões do playground
SESSION_SECRET=

# Secret para webhooks futuros (Chatwoot, etc.)
WEBHOOK_SECRET=

# Chave de encriptação de dados sensíveis
ENCRYPTION_KEY=

# ============================================
# CDN / STORAGE / MATERIAIS E MÍDIAS (OPCIONAL)
# ============================================
# [OPCIONAL] URL base da CDN para arquivos de mídia
# Deixe vazio se for usar apenas URLs externas
CDN_BASE_URL=

# [OPCIONAL] Link do Google Drive com cases de sucesso (enviado na Etapa 6)
MATERIALS_DRIVE_URL=https://drive.google.com/drive/folders/seu-link-de-cases

# [OPCIONAL] Link da página ou estudo de caso
CASE_STUDY_URL=https://seusite.com/cases

# [OPCIONAL] URLs diretas para mídias do sistema
AUDIO_PADRAO_URL=
CASE_GENERICO_URL=
FOLLOW_UP_IMAGE_URL=

# ============================================
# APLICAÇÃO
# ============================================
# Ambiente: development, staging, production
APP_ENV=development

# Timezone da aplicação
TIMEZONE=America/Sao_Paulo

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# API SERVER
# ============================================
API_HOST=127.0.0.1
API_PORT=8000

# Domínio público para Traefik (usado no docker-compose)
# Ex: sdr.seudominio.com → Traefik roteia para o container
SDR_DOMAIN=sdr.seudominio.com

# ============================================
# PLAYGROUND SERVER
# ============================================
PLAYGROUND_HOST=127.0.0.1
PLAYGROUND_PORT=8001

# ============================================
# LIMITES E TIMEOUTS
# ============================================
# Timeout para chamadas HTTP (segundos)
HTTP_TIMEOUT=30

# Timeout para LLM (segundos)
LLM_TIMEOUT=60

# Máximo de mensagens no histórico
MAX_HISTORY_MESSAGES=20

# ============================================
# REDIS (OPCIONAL - CACHE E FILAS)
# ============================================
# [OPCIONAL] Deixe vazio se não for usar Redis
REDIS_URL=
REDIS_TTL=3600

# ============================================
# RATE LIMITING (OPCIONAL)
# ============================================
# [OPCIONAL] Requests por minuto por sessão
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
